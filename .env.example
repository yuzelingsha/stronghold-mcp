# stronghold-mcp configuration.
#
# Copy to .env and fill in. The MCP server and the drive daemon read it at startup; a variable already
# set in the environment wins over the file. Everything here is optional: the defaults point at a local
# game server with no login. Never commit a filled-in copy.

# ---------------------------------------------------------------- game server
# The WebSocket endpoint the seat connects to. The HTTP origin used for the login request, and for
# fetching the battle simulation, is derived from it.
STRONGHOLD_WS_URL=ws://127.0.0.1:3000/ws
# STRONGHOLD_HTTP_URL=https://ark.example.com

# The display name this seat connects as.
STRONGHOLD_NAME=MCP Player

# ---------------------------------------------------------------- authentication
# Only needed when the site is behind a login gate. The adapter exchanges these for an HttpOnly
# session cookie in memory; they are never logged and never written to disk by this project.
# The same cookie is used to reach the simulation endpoint.
# STRONGHOLD_AUTH_USER=
# STRONGHOLD_AUTH_PASSWORD=

# Or supply an already-obtained session cookie instead of credentials.
# STRONGHOLD_AUTH_COOKIE=

# ---------------------------------------------------------------- battle simulation
# 1 = run the match's battles locally. The simulation is fetched lazily on the first battle, so this
# does not delay startup.
STRONGHOLD_LOCAL_BATTLE=1

# auto (default) bursts only inside a training room; fast always bursts; realtime never does.
STRONGHOLD_BATTLE_MODE=auto

# Where materialized simulation trees are cached.
# STRONGHOLD_SIM_CACHE=~/.cache/stronghold-mcp

# Optional fast path: a game installation on this machine, so nothing is downloaded.
# Point at the repository root (or its server/ directory), or directly at sim/spec.js.
# STRONGHOLD_SIM_ROOT=/srv/apps/Stronghold-Protocol
# STRONGHOLD_SIM_SPEC=/srv/apps/Stronghold-Protocol/server/sim/spec.js

# Let the resolver walk up from the working directory looking for an installation. Off by default:
# a silent search can pick up an unrelated checkout and mask the server as the source.
# STRONGHOLD_SIM_AUTODISCOVER=1

# ---------------------------------------------------------------- MCP tools
# compact (default): the 9 generic tools only; every action goes through stronghold_action.
# full: also register one convenience tool per protocol action (62 tools in total).
# STRONGHOLD_MCP_TOOLS=compact

# ---------------------------------------------------------------- observation
# The game's data/ directory on this machine. Unset (the default): the data files are read from the
# server's /data/, the same files browsers load, so nothing of the game is needed here.
# STRONGHOLD_DATA_DIR=/srv/apps/Stronghold-Protocol/data

# The seat's deployable board region "r0,r1,c0,c1". Defaults to the game's own GEO.FIELD.
# STRONGHOLD_FIELD_REGION=9,12,2,10

# ---------------------------------------------------------------- HTTP transport
# stdio (default) for a local MCP client; http serves Streamable HTTP at /mcp for a reverse proxy.
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8787
# Basic Auth for /mcp. Unset: the login credentials above (STRONGHOLD_AUTH_*, then SP_AUTH_*) are used.
# MCP_HTTP_USER=
# MCP_HTTP_PASSWORD=
# A session with no request for this many seconds is closed, with its game seat. 0 = only on DELETE.
# MCP_HTTP_IDLE_SECONDS=1800

# ---------------------------------------------------------------- driver
DRIVER_HOST=127.0.0.1
DRIVER_PORT=8899
# Seconds, for both the daemon and the Python SDK.
DRIVER_TIMEOUT=180

# ---------------------------------------------------------------- server side (not this project)
# Set on the GAME SERVER, not here. Listed for reference; see docs/plugin-install.md and
# docs/training-rooms.md.
#   SP_PLUGIN_SCRIPTS=trusted          enable the stronghold-agent plugin (trusted-force for public)
#   SP_TRAIN_TIMER_SCALE=0             training rooms skip presentation delays
#   SP_TRAIN_SCOPE=train               ... only for rooms that asked with train: true
